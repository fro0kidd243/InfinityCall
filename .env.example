# Copie este arquivo para .env e preencha com os dados da SUA conta de telefonia.
# Nunca publique o .env nem envie seus tokens a outras pessoas.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu_token_privado
TWILIO_PHONE_NUMBER=+15551234567
# URL pública de um documento TwiML/Voice configurado no provedor:
TWIML_APP_URL=https://SEU-ENDERECO-PUBLICO/voice
PORT=3000
